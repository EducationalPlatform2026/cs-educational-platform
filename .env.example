# PostgreSQL
POSTGRES_USER=csplatform
POSTGRES_PASSWORD=csplatform_password
POSTGRES_DB=csplatform_db
POSTGRES_PORT=5432

# Derived connection string (used by the Go backend)
DATABASE_URL=postgres://csplatform:csplatform_password@localhost:5432/csplatform_db?sslmode=disable

# JWT signing secret — MUST be replaced with a cryptographically random value in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum recommended length: 32 bytes (64 hex characters).
JWT_SECRET=change_me_to_a_long_random_secret

# Allowed CORS origins (comma-separated). Defaults to http://localhost:5173 if unset.
# In production set this to your actual frontend URL, e.g.:
# CORS_ORIGIN=https://yourapp.example.com
CORS_ORIGIN=http://localhost:5173
